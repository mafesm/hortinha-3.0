@startuml Hortinha_Sequencia_UART

skinparam dpi 150
skinparam pageMargin 15
skinparam pageExternalColor white

title Fluxo de Comunicação e Dados

skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam titleFontSize 18
skinparam titleFontStyle bold
skinparam sequenceMessageAlign center

skinparam participant {
  BackgroundColor #D9E2A8
  BorderColor     #5E3B4D
  FontColor       #4B2B30
  FontSize        13
}

skinparam note {
  BackgroundColor #AA96B7
  BorderColor     #4B2B30
  FontColor       #FFFFFF
  FontSize        12
}

skinparam sequence {
  ArrowColor          #5E3B4D
  ArrowFontColor      #4B2B30
  ArrowFontSize       12
  LifeLineBorderColor #5E3B4D
  GroupBackgroundColor #D9E2A8
  GroupBorderColor     #5E3B4D
  GroupFontColor       #4B2B30
  GroupFontSize        13
  DividerBackgroundColor #D9E2A8
  DividerBorderColor     #5E3B4D
  DividerFontColor       #4B2B30
  DividerFontSize        13
}

participant "sensores.h\n(Arduino)" as SENS
participant "modos.h\n(Arduino)" as MODOS
participant "uvc.h\n(Arduino)" as UVC_ARD
participant "alertas_local.h\n(Arduino)" as ALRT_ARD
participant "serial_proto.h\n(Arduino)" as PROTO_ARD
participant "serial_proto.h\n(ESP32)" as PROTO_ESP
participant "alertas_espec.h\n(ESP32)" as ALRT_ESP
participant "agendador_uvc.h\n(ESP32)" as AGEND
participant "persistencia\n(ESP32)" as PERSIST
participant "servidorweb.h\n(ESP32)" as WEB

== Loop principal — telemetria a cada 1 segundo ==

SENS -> PROTO_ARD : temperatura · umidade\nluz · presença
PROTO_ARD -> PROTO_ESP : JSON\n{"temp","umid","luz","pres",\n"manual","irr","uvc","angulo"}

== Geração de alertas especiais — ESP32 ==

PROTO_ESP -> ALRT_ESP : gerarAlertasEspeciais(temp, umid, luz)
ALRT_ESP -> ALRT_ESP : avalia faixas reais\n(Botrytis · Bremia · Pythium · Cercospora)\n+ faixas fictícias [FANTASIA]
ALRT_ESP -> PROTO_ESP : ResultadoAlertas\n{ texto, temRisco }
note right
  dados.alertas e dados.temRisco
  são recalculados a cada
  pacote UART recebido
end note

== Persistência — a cada 20 segundos ==

PROTO_ESP -> PERSIST : escreverLeituraJSON(timestamp, json)
note right
  Salvo em /data/YYYYMMDD.csv
  json = gerarJsonDados()
end note

== Alertas locais — Arduino ==

SENS -> ALRT_ARD : leituras contínuas\n(com histerese)
ALRT_ARD -> PROTO_ARD : enviarNotificacao(tipo)
PROTO_ARD -> PROTO_ESP : NOTIF:<TEMP|UMID|LUZ|PRES|FOTO>
note right
  Dispara PISCA_COR()
  no LED RGB local
end note
PROTO_ESP -> PROTO_ESP : GEN_NOTF(tipo)\n(log local)

== Solicitação manual de UVC — chave DIP (Arduino) ==

MODOS -> MODOS : lerModos()\ndetecta borda de subida\nno modo UVC (DIP1,!2,!3,4)
MODOS -> UVC_ARD : uvcSolicitado = true\n(pulso único na borda)
UVC_ARD -> UVC_ARD : travaUVC()\nse presença: bloqueia\ne zera uvcSolicitado
UVC_ARD -> UVC_ARD : uvcAtivo = uvcSolicitado\ndigitalWrite(UVC_PIN, HIGH/LOW)

== Agendador UVC automático — a cada 10 segundos (ESP32) ==

PROTO_ESP -> AGEND : dados.temRisco\ndados.modoManual\ndados.presenca
AGEND -> AGEND : condicoesAptasParaCicloUVC()\n= !modoManual && temRisco
AGEND -> PROTO_ARD : UVC:1
note right
  Ciclo de 15 s
  interrompido se
  dados.presenca = true
end note
PROTO_ARD -> UVC_ARD : uvcSolicitado = true
AGEND -> PROTO_ARD : UVC:0
PROTO_ARD -> UVC_ARD : uvcSolicitado = false

== Requisição web — usuário ==

WEB -> PROTO_ESP : gerarJsonDados()
PROTO_ESP -> WEB : JSON completo\n(temp · umid · luz · presença\nalertas · temRisco · modo\nirr · uvc · angulo)
WEB -> PERSIST : listarArquivos() / baixarArquivo()

@enduml
