@startuml Hortinha_Dependencias_Internas

top to bottom direction
skinparam dpi 150
skinparam pageMargin 15
skinparam pageExternalColor white

title Dependências Internas dos Módulos

skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam titleFontSize 18
skinparam titleFontStyle bold
skinparam linetype ortho

skinparam package {
  BackgroundColor #E1F5EE
  BorderColor     #0F6E56
  FontColor       #085041
  FontStyle       bold
  FontSize        14
}

skinparam component {
  BackgroundColor #E6F1FB
  BorderColor     #185FA5
  FontColor       #0C447C
  FontSize        13
}

skinparam note {
  BackgroundColor #FFF2D6
  BorderColor     #CFA33B
  FontColor       #5A4500
  FontSize        12
}

' ─────────────────────────────────────────
'  ESP32 — módulos internos
' ─────────────────────────────────────────
package "ESP32" {

  [serial_proto.h\nParseia JSON\nstruct PACOTE]           as PROTO_ESP
  [agendador_uvc.h\nCiclo UVC automático\nbloqueio por presença] as AGEND_UVC
  [alertas_espec.h\ndoenças fantasia]    as ALRT_ESP
  [persistencia.h/.cpp\nLittleFS · CSV diário\nlimpeza 15 dias] as PERSIST
  [servidorweb.h\n/ · /getData\n/listarArquivos · /baixarArquivo] as WEBSERV
  [dashboard.h\nHTML responsivo\nLED virtual · alertas visuais]  as DASH
}

PROTO_ESP  -down-> AGEND_UVC : temp · umid · presença
PROTO_ESP  -down-> ALRT_ESP  : temperatura · umidade
PROTO_ESP  -down-> PERSIST   : escreverLeituraJSON()
ALRT_ESP   -up-> PROTO_ESP   : dados.alertas
WEBSERV    -up-> PROTO_ESP   : gerarJsonDados()
WEBSERV    -right-> PERSIST  : listar / baixar arquivos
DASH       -down-> WEBSERV   : rota "/"

' ─────────────────────────────────────────
'  HARDWARE / INFRA — ESP32
' ─────────────────────────────────────────
package "Hardware / Infra — ESP32" {
  [Wi-Fi\nHTTP porta 80]           as HW_WIFI
  [LittleFS\n/data/YYYYMMDD.csv]   as HW_FS
  [NTP\npool.ntp.org · UTC-3]      as HW_NTP
}

WEBSERV   -down-> HW_WIFI : server.begin()\nhandleClient()
PERSIST   -down-> HW_FS   : open / write / remove
PROTO_ESP -down-> HW_NTP  : time(nullptr)

@enduml
